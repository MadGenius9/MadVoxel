  // Make blood moons slightly rarer but heavier, and put the scarecrow in them.
  "hordeSchedule": {
    "everyNDays": 8,
    "baseWaveSize": 5,
    "heavyZombie": "example_pumpkin:scarecrow",
    "heavyFromHordeNumber": 2,
    "heavyShare": 0.3
  },

  // Longer days, so there is time to farm.
  "config": {
    "dayLengthSeconds": 1500
