{
  // ---------------------------------------------------------------------------
  // A new crop, end to end: seed item, produce item, the crop itself, a recipe to
  // cook it, and the wild plant you find the seeds on.
  //
  // Anything without an explicit "$op" is added if new and patched if it already
  // exists, so this file both creates content and tunes vanilla content.
  // ---------------------------------------------------------------------------

  "items": [
    {
      "id": "example_pumpkin:seed_pumpkin",
      "displayName": "Pumpkin Seed",
      "description": "Plant in a farm plot.",
      "category": "Resource",
      "maxStack": 64,
      "surfaceFamily": "Foliage",
      "tint": "#c78a3a",
      "tradeValue": 7
    },
    {
      "id": "example_pumpkin:pumpkin",
      "displayName": "Pumpkin",
      "category": "Consumable",
      "maxStack": 32,
      "surfaceFamily": "Foliage",
      "tint": "#d2741f",
      "foodRestore": 12,
      "tradeValue": 6
    },
    {
      "id": "example_pumpkin:pumpkin_pie",
      "displayName": "Pumpkin Pie",
      "category": "Consumable",
      "maxStack": 8,
      "surfaceFamily": "Cloth",
      "tint": "#c98b45",
      "foodRestore": 55,
      "staminaRestore": 35,
      "healthRestore": 8,
      "tradeValue": 26
    },

    // Patching vanilla: only the fields named here change, everything else on the
    // definition is left exactly as it was.
    {
      "id": "madvoxel:baked_potato",
      "$op": "patch",
      "staminaRestore": 22
    }
  ],

  "crops": [
