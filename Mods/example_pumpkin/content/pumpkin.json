      "xpPerHarvest": 14
    }
  ],

  "blocks": [
    {
      "id": "example_pumpkin:wild_pumpkin",
      "displayName": "Wild Pumpkin",
      "solid": false,
      "opaque": false,
      "hardness": 0.2,
      "surfaceFamily": "Foliage",
      "tint": "#7b8a34",
