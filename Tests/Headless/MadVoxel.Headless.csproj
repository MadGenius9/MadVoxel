<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs MadVoxel's engine-agnostic code outside Unity. It compiles the real gameplay
    sources against a small executable UnityEngine shim (UnityShim.cs), so these are
    genuine runs of the shipping code, not a parallel copy of it.

    This project lives outside Assets/, so Unity never compiles it.
    Run with: dotnet run from inside this folder.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <AssemblyName>MadVoxel.Headless</AssemblyName>
    <RootNamespace>MadVoxel.Headless</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Unity-style public serialized fields trip these; they are not defects here. -->
    <NoWarn>CS0649;CS0169;CS0414;CS0067</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="Test harness">
    <Compile Include="UnityShim.cs" />
    <Compile Include="Harness.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="ContentTests.cs" />
    <Compile Include="TerrainTests.cs" />
    <Compile Include="BuildTests.cs" />
    <Compile Include="FarmingTests.cs" />
    <Compile Include="ModTests.cs" />
    <Compile Include="InventoryTests.cs" />
    <Compile Include="SaveTests.cs" />
    <Compile Include="PerkTests.cs" />
    <Compile Include="UiTests.cs" />
    <Compile Include="PowerTests.cs" />
    <Compile Include="WorldTests.cs" />
    <Compile Include="ColonyTests.cs" />
